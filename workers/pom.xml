<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.adamastorx</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>workers</artifactId>

  <name>workers</name>
  <description>Kafka consumers, async processing (ADR 0011)</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!--
      spring-kafka is the client library; spring-boot-kafka is Boot 4's
      (modularised) autoconfiguration for it (KafkaAutoConfiguration,
      KafkaProperties), not pulled in transitively by spring-kafka
      itself, so it's declared explicitly (parent POM pins the version,
      ADR 0007).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
    </dependency>
    <!--
      spring-kafka's JsonSerializer/JsonDeserializer are built on classic
      Jackson 2 (com.fasterxml.jackson.*), not the Jackson 3
      (tools.jackson.*) that Boot 4.1's spring-boot-starter-jackson pulls
      in by default — spring-boot-starter-webmvc no longer brings this
      transitively, so it's declared explicitly (version pinned by the
      parent POM's Jackson 2 BOM import, ADR 0007).
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!--
      No business HTTP API here — spring-boot-starter-webmvc is pulled in
      solely to give actuator an embedded servlet container so
      /actuator/health/liveness and /readiness exist over HTTP for kubelet
      probes, exactly like gateway/api (ADR 0011). workers still gets no
      Kubernetes Service (ADR 0009) — this is for the probe port only.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Registers /actuator/prometheus itself (observability#2, ADR 0014)
      — spring-boot-starter-actuator alone brings Micrometer's core but
      not the Prometheus registry, so this endpoint 404'd until this was
      added, found deploying the real Prometheus scrape. Exposed over
      HTTP via management.endpoints.web.exposure.include (application.yml)
      — Boot doesn't expose it by default even with this dependency
      present.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!--
      Traces only (observability#1, ADR 0013) — metrics stay on the
      existing /actuator/prometheus scrape endpoint rather than routing
      through the OTel Collector. micrometer-tracing-bridge-otel wires
      Spring-Kafka's observation instrumentation (the @KafkaListener
      side of the same producer/consumer trace propagation api's
      KafkaTemplate side uses) to produce OTel spans;
      opentelemetry-exporter-otlp ships them via
      management.otlp.tracing.* (application.yml). The
      spring-boot-micrometer-tracing* pair is Boot 4's tracing
      autoconfiguration, split into its own modules same as
      spring-boot-kafka/-flyway — spring-boot-starter-actuator only
      brings the metrics side (spring-boot-micrometer-metrics)
      transitively, not this.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
    </dependency>
    <!--
      services#25 (ADR 0018): clinvar_release / clinvar_variant_index are
      persisted by this module — workers' first PVC precedent (ADR 0018)
      has a Postgres-write counterpart here too, its first database write
      of any kind. Deliberately NOT paired with flyway-core/spring-boot-
      flyway the way api's is (compare api/pom.xml) — see
      V2__create_clinvar_tables.sql's header comment for why schema
      ownership stays single (api's Flyway history only). hibernate.ddl-
      auto is set to none in application.yml for the same reason: this
      module must never attempt to create or alter schema itself.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!--
      Version pinned above the parent POM's managed default — same
      CVE-2026-54291 (HIGH, SCRAM-SHA-256-PLUS downgrade MITM) reasoning as
      api/pom.xml's identical pin, caught by this PR's own Trivy gate.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <scope>runtime</scope>
    </dependency>
    <!--
      services#25 (ADR 0018): htsjdk, in-process, for tabix-indexing the
      downloaded ClinVar VCF (ClinVarTabixIndexer) and streaming through it
      once per ingestion to build clinvar_variant_index
      (ClinVarVariantIndexBuilder). Current stable release per Maven
      Central at the time this was added (checked directly, not assumed).
    -->
    <dependency>
      <groupId>com.github.samtools</groupId>
      <artifactId>htsjdk</artifactId>
      <version>4.3.0</version>
    </dependency>
    <!--
      htsjdk 4.3.0 transitively pulls org.apache.commons:commons-compress
      1.26.0 and org.xerial.snappy:snappy-java 1.1.10.5. Neither version
      carries a known CVE as of this PR (1.26.0 already fixed
      CVE-2024-25710/CVE-2024-26308; 1.1.10.5 postdates the LZ4-related
      snappy-java CVEs) — but both are pinned up to their current latest
      patch release anyway, checked directly against Maven Central rather
      than left at whatever htsjdk happens to manage, same discipline as
      the postgresql pin above and api/pom.xml's existing one. Belt-and-
      suspenders against this PR's own Trivy gate flagging either
      transitively later.
    -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.28.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial.snappy</groupId>
      <artifactId>snappy-java</artifactId>
      <version>1.1.10.7</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test-scope only — production code never runs Flyway here (see the
      pom's earlier comment on hibernate.ddl-auto/schema ownership).
      ClinVarIngestionServiceIntegrationTest migrates its own Testcontainers
      Postgres directly (a test-scoped mirror of api's
      V2__create_clinvar_tables.sql) rather than standing up a whole
      second api Spring context just to get the schema created.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
