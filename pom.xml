<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot / Java / plugin versions are pinned here, exactly once (ADR 0007). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.adamastorx</groupId>
  <artifactId>services</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>services</name>
  <description>AdamastorX application services — single multi-module reactor (ADR 0007)</description>

  <modules>
    <module>api</module>
    <module>workers</module>
    <module>watchlist-service</module>
    <module>news-ingestor</module>
    <module>market-data-ingestor</module>
    <module>aggregator</module>
  </modules>

  <properties>
    <java.version>25</java.version>

    <!-- Security overrides of versions Spring Boot's own BOM manages.
         The image scan gates every PR on HIGH/CRITICAL CVEs and Boot
         4.1.0 (and 4.1.1, which only reaches Tomcat 11.0.24 / Jackson
         2.21.5 / 3.1.5) still ships these:
           tomcat-embed-core 11.0.22: CVE-2026-65182, -65905, -68525
             (CRITICAL: security-constraint / authentication bypass),
             fixed in 11.0.25
           jackson 2.x 2.21.4: CVE-2026-89407, -89425, -68497, -91776,
             -91777 (HIGH), fixed in 2.21.7
           jackson 3.x (tools.jackson) 3.1.4: same CVEs, fixed in 3.1.7
           spring-webmvc 7.0.8: CVE-2026-47884 (CRITICAL, remote), fixed in 7.0.9
             (published after Boot 4.1.0/4.1.1; found 2026-10-06 when the scan
             gate failed an unrelated PR)
           netty-handler 4.2.15 (api): CVE-2026-75595 (CRITICAL, SNI
             routing bypass via fragmented TLS ClientHello), fixed in 4.2.17
         Property names are Boot 4.1's own (spring-boot-dependencies):
         `jackson-2-bom.version` is the com.fasterxml 2.x line and
         `jackson-bom.version` is the tools.jackson 3.x line. Drop each
         override once the Boot BOM manages a version at or above it. -->
    <tomcat.version>11.0.25</tomcat.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <netty.version>4.2.17.Final</netty.version>
    <spring-framework.version>7.0.9</spring-framework.version>
  </properties>
</project>
