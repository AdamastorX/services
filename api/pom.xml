<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.adamastorx</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>api</artifactId>

  <name>api</name>
  <description>Core business-logic service, routed to from gateway</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Registers /actuator/prometheus itself (observability#2, ADR 0014)
      — spring-boot-starter-actuator alone brings Micrometer's core but
      not the Prometheus registry, so this endpoint 404'd until this was
      added, found deploying the real Prometheus scrape. Exposed over
      HTTP via management.endpoints.web.exposure.include (application.yml)
      — Boot doesn't expose it by default even with this dependency
      present.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!--
      Traces only (observability#1, ADR 0013) — metrics stay on the
      existing /actuator/prometheus scrape endpoint rather than routing
      through the OTel Collector. micrometer-tracing-bridge-otel wires
      Boot's RestClient/Spring-Kafka observation instrumentation to
      produce OTel spans; opentelemetry-exporter-otlp ships them via
      management.otlp.tracing.* (application.yml). The
      spring-boot-micrometer-tracing* pair is Boot 4's tracing
      autoconfiguration, split into its own modules same as
      spring-boot-kafka/-flyway — spring-boot-starter-actuator only
      brings the metrics side (spring-boot-micrometer-metrics)
      transitively, not this.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!--
      spring-kafka is the client library; spring-boot-kafka is Boot 4's
      (modularised) autoconfiguration for it (KafkaAutoConfiguration,
      KafkaProperties), not pulled in transitively by spring-kafka
      itself, so it's declared explicitly (parent POM pins the version,
      ADR 0007).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-kafka</artifactId>
    </dependency>
    <!--
      spring-kafka's JsonSerializer/JsonDeserializer are built on classic
      Jackson 2 (com.fasterxml.jackson.*), not the Jackson 3
      (tools.jackson.*) that Boot 4.1's spring-boot-starter-jackson pulls
      in by default — spring-boot-starter-webmvc no longer brings this
      transitively, so it's declared explicitly (version pinned by the
      parent POM's Jackson 2 BOM import, ADR 0007).
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!--
      Version pinned above the parent POM's managed 42.7.11: that version
      carries CVE-2026-54291 (HIGH, SCRAM-SHA-256-PLUS downgrade
      man-in-the-middle), fixed in 42.7.12 — caught by this PR's own
      Trivy gate (ADR 0006/platform#6), same as the apk/CVE fixes already
      applied to the Dockerfile's runtime base.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <scope>runtime</scope>
    </dependency>
    <!--
      Flyway 10+ split database-specific support out of flyway-core into
      its own artifact (services#4, ADR 0012) — flyway-core alone can't
      migrate a PostgreSQL database.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!--
      flyway-core is the client library; spring-boot-flyway is Boot 4's
      (modularised) autoconfiguration for it (FlywayAutoConfiguration),
      not pulled in transitively by spring-boot-starter-data-jpa or
      flyway-core themselves — same pattern spring-boot-kafka already
      needed alongside spring-kafka. Without it, Flyway never runs (no
      error, no log line at all) and the app boots successfully straight
      into "relation work_items does not exist" on the first query.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <!--
      services#5 (ADR 0016). Unlike spring-kafka/flyway-core, this starter's
      own POM already declares spring-boot-data-redis (Boot 4.1's
      modularised autoconfiguration for it) as a direct compile dependency
      — confirmed by reading the starter's published POM, not assumed from
      the Kafka/Flyway precedent — so, unlike those two, no second
      artifact is needed here for the autoconfiguration to actually
      activate. Brings spring-data-redis + lettuce-core (the client)
      transitively too.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!--
      services#24 (ADR 0018): htsjdk, in-process, for the request-path
      point lookup against the current release's tabix-indexed VCF
      (ClinVarVcfQueryService) — not a bcftools/tabix subprocess (ADR
      0018's explicit call: per-request fork/exec latency and stdout-
      parsing fragility are worse than this one extra JVM dependency).
      Same version as workers/pom.xml, which also depends on htsjdk for
      ingestion — kept in sync deliberately since both modules read/write
      the same tabix file format.
    -->
    <dependency>
      <groupId>com.github.samtools</groupId>
      <artifactId>htsjdk</artifactId>
      <version>4.3.0</version>
    </dependency>
    <!-- Same pin/reasoning as workers/pom.xml's identical block. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.28.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial.snappy</groupId>
      <artifactId>snappy-java</artifactId>
      <version>1.1.10.7</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers 2.x (Boot 4.1 pins 2.0.5) renamed its artifacts —
      org.testcontainers:postgresql/junit-jupiter (the 1.x names) no
      longer exist; it's testcontainers-postgresql/testcontainers-junit-jupiter
      now.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Redis has no official org.testcontainers:testcontainers-redis module
      (confirmed via Maven Central search — no such artifact exists), and
      spring-boot-testcontainers ships no RedisContainerConnectionDetailsFactory
      either (checked its jar directly), unlike JDBC/Postgres's built-in
      @ServiceConnection support. The third-party com.redis:testcontainers-redis
      artifact would restore @ServiceConnection convenience but isn't worth
      a new dependency for one test class — plain GenericContainer here
      (testcontainers-core) plus @DynamicPropertySource wiring in the test
      itself is a few extra lines, no new dependency.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
